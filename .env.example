APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://ferrox:ferrox@localhost:5432/ferrox
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
INTERNAL_API_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=ferrox
JWT_AUDIENCE=ferrox-api
ACCESS_TOKEN_EXPIRE_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=admin@ferrox.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
LLM_PROVIDER_ORDER=gemini,groq,openai
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
ENABLE_GROUNDED_ENRICHMENT=false
GEMINI_GROUNDING_MODEL=gemini-2.5-flash
GEMINI_INPUT_COST_PER_MILLION=0
GEMINI_OUTPUT_COST_PER_MILLION=0
GROQ_INPUT_COST_PER_MILLION=0
GROQ_OUTPUT_COST_PER_MILLION=0
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
LLM_TIMEOUT_SECONDS=30
SCRAPER_TIMEOUT_SECONDS=15
MAX_SOURCE_CHARS=120000
DOCUMENT_CHUNK_CHARS=12000
DOCUMENT_CHUNK_OVERLAP_CHARS=500
EMBEDDING_CHUNK_CHARS=6000
EMBEDDING_CHUNK_OVERLAP_CHARS=300
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
DUPLICATE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_SEARCH_DEFAULT_LIMIT=10
ENABLE_PDF_OCR=true
PDF_OCR_LANGUAGE=eng
PDF_OCR_DPI=200
PDF_OCR_MIN_TEXT_CHARS=24
MAX_CATALOG_UPLOAD_BYTES=10000000
MAX_CATALOG_ROWS=10000
MAX_REQUEST_BYTES=110000000
MAX_PDF_UPLOAD_BYTES=20000000
MAX_REFERENCE_UPLOAD_BYTES=100000000
MAX_REFERENCE_ROWS=500000
DELIVERY_EXPECTED_COLUMNS=252
MANUFACTURER_DOMAIN_ALLOWLIST=
OBJECT_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.data/objects
S3_BUCKET=ferrox-sources
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ferrox
S3_SECRET_ACCESS_KEY=change-this-local-secret
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
WORKER_POLL_SECONDS=2
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=14
BACKUP_PREFIX=backups/postgres
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
